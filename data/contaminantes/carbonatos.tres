[ext_resource type="Script" path="res://sim/contaminante.gd" id="1"]

[resource]
script = ExtResource("1")
nombre = "Carbonatos / bicarbonatos"
descripcion = "CO₂ de formación, del aire por el embudo, degradación térmica o sobretratamiento con bicarbonato. Suben Pf y Mf con pH que baja, y precipita el calcio (§1.7)."
