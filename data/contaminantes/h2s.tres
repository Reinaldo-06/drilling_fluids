[gd_resource type="Resource" script_class="Contaminante" load_steps=2 format=3]

[ext_resource type="Script" path="res://sim/contaminante.gd" id="1"]

[resource]
script = ExtResource("1")
nombre = "H₂S"
descripcion = "Ácido sulfhídrico de la formación. Tóxico. Baja pH y alcalinidades; ennegrece el lodo (§1.8). Cada mmol de H₂S neutraliza un OH⁻ (H₂S + OH⁻ → HS⁻): 1/32,06 meq por mg/l de sulfuro. El H⁺ desplaza Ca²⁺ de la arcilla y disuelve finos calcáreos: por eso la Tabla 4 marca calcio en alza (intercambio 🧩)."
unidad = "mg/l de sulfuros"
aportes = {"ion_sulfuro": 1.0, "acido_meq": 0.0312, "intercambio_ca": 0.25}
