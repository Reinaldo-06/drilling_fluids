[gd_resource type="Resource" script_class="Regla" load_steps=2 format=3]

[ext_resource type="Script" path="res://sim/regla.gd" id="1"]

[resource]
script = ExtResource("1")
id = "calcio_carbonatos_cal_con_ph_alto"
titulo = "Cal sobre carbonatos con pH alto"
tipo = "error"
momento = "al_tratar"
condicion = "accion.producto == \"cal\" and antes.mf > 5.0 and antes.mf_carbonatos > 2.5 and antes.ph > 11.3"
explicacion = "Para precipitar carbonatos la fuente de calcio se elige por el pH: < 10,3 cal; 10,3–11,3 cal + yeso; > 11,3 yeso. Con el pH sobre 11,3 la cal aporta calcio pero también más OH⁻, y el pH se va arriba. Usa yeso: da calcio y baja el pH."
referencia = "mud-engineer-reference.md §1.7"
