script = ExtResource("1")
nombre = "Lutita reactiva (CAIMÁN-3)"
descripcion = "Lutita con montmorillonita desde 3.200 ft (mud-programs.md, CAIMÁN-3). Sin inhibición se dispersa: sube MBT, VP y PC. Se come el K⁺, la amina y el PHPA (simulation-logic.md §13.5)."
