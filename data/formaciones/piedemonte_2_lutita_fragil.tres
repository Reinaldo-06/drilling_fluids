[gd_resource type="Resource" script_class="Formacion" load_steps=2 format=3]

[ext_resource type="Script" path="res://sim/formacion.gd" id="1"]

[resource]
script = ExtResource("1")
nombre = "Lutita frágil (PIEDEMONTE-2)"
descripcion = "Lutita que no se hincha: la inestabilidad es mecánica. El MBT y el K⁺ están bien; se derrumba si la densidad queda baja. Más inhibición no la arregla (reference-wells.md §2)."
litologia = "lutita fracturada"
tope_ft = 5000.0
base_ft = 9000.0
porosidad = 0.08
cic_meq_100g = 4.0
tipo_arcilla = "illita"
fraccion_gruesos = 0.7
fraccion_medios = 0.2
fragil_mecanicamente = true
densidad_minima_estable_ppg = 10.8
