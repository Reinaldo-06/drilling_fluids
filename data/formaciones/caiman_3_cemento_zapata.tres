[gd_resource type="Resource" script_class="Formacion" load_steps=2 format=3]

[ext_resource type="Script" path="res://sim/formacion.gd" id="1"]

[resource]
script = ExtResource("1")
nombre = "Cemento de la zapata (CAIMÁN-3)"
descripcion = "Al iniciar la intermedia se rota, dentro del revestidor de 13⅜\", el cemento entre el collar flotador (2.420 ft) y la zapata (2.500 ft). No es formación nueva. Aporta cal libre y finos de cemento: es la ÚNICA fuente de esta contaminación (mud-programs.md, CAIMÁN-3; mud-engineer-reference.md §1.3)."
litologia = "cemento fraguado"
en_revestimiento = true
tope_ft = 2420.0
base_ft = 2500.0
porosidad = 0.35
cic_meq_100g = 0.0
tipo_arcilla = "ninguna"
fraccion_gruesos = 0.5
fraccion_medios = 0.3
contaminante = "cemento"
contaminante_por_bbl_roca = 40.0
