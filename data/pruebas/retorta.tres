[ext_resource type="Script" path="res://sim/prueba_laboratorio.gd" id="1"]

[resource]
script = ExtResource("1")
id = "retorta"
nombre = "Retorta"
descripcion = "% agua, % aceite y % sólidos en volumen, leídos en la probeta a 0,5 %. Da el Fw de las fórmulas de dosis (game-design-mechanics.md, Qué se ve en la retorta). 🧩 60 min de espera."
