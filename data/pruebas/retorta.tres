chequeos = PackedStringArray("diaria")
equipo = "retorta"
produce = ""
lecturas = [{"nombre": "agua_pct", "fuente": "retorta_agua_pct", "unidad": "% vol", "resolucion": 0.5}, {"nombre": "aceite_pct", "fuente": "retorta_aceite_pct", "unidad": "% vol", "resolucion": 0.5}, {"nombre": "solidos_pct", "fuente": "retorta_solidos_pct", "unidad": "% vol", "resolucion": 0.5}, {"nombre": "fw", "fuente": "retorta_fw", "unidad": "", "resolucion": 0.005}]
