[gd_resource type="Resource" script_class="PruebaLaboratorio" load_steps=2 format=3]

[ext_resource type="Script" path="res://sim/prueba_laboratorio.gd" id="1"]

[resource]
script = ExtResource("1")
id = "ggt_sulfuros"
nombre = "Garrett Gas Train (sulfuros)"
descripcion = "Sulfuros solubles en mg/l con tubo detector. Cuantitativo para sulfuros (mud-engineer-reference.md §7, §1.8). 🧩 25 min; paso de 2 mg/l hasta 100 y de 10 mg/l por encima."
muestra = "filtrado"
minutos_activos = 25
minutos_espera = 0
requiere = PackedStringArray("filtrado_api")
nivel = "ampliada"
chequeos = PackedStringArray()
equipo = "garrett"
produce = ""
lecturas = [{"nombre": "sulfuros", "fuente": "sulfuro", "unidad": "mg/l", "resolucion": 2.0, "limite_fino": 100.0, "resolucion_gruesa": 10.0}]
