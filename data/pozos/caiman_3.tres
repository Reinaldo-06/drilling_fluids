[resource]
script = ExtResource("1")
nombre = "CAIMÁN-3"
descripcion = "Pozo ficticio en los llanos, convencional: superficial bentonítica, intermedia KCl/PHPA con lutita reactiva desde 3.200 ft y producción en RDF."
