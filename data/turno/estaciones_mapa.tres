[gd_resource type="Resource" load_steps=2 format=3]

[ext_resource type="Script" path="res://sim/turno_tabla.gd" id="1"]

[resource]
script = ExtResource("1")
id = "estaciones_mapa"
descripcion = "Puente entre el overworld y el turno (docs/plan-desarrollo.md, Paso 2). \"estaciones\": cada id de estación del mapa (game/overworld/mapa_locacion.gd) → la estación del turno donde está (sim/accion.gd, ESTACIONES) y las acciones que se pueden hacer ahí. \"acciones\": nombre para el menú y parámetros (con ? los opcionales). Las acciones que piden estar en cierta estación salen de Accion.ESTACION_DE; este archivo solo dice qué ofrece cada lugar del mapa. Las válvulas no ofrecen acciones todavía (Hito 3). \"parametros\": pregunta de cada parámetro y \"opciones_fijas\" las que no dependen del escenario (producto, tanque, prueba y diagnóstico las arma la sesión)."
valores = {
"acciones": {
"chequeo_rapido": {
"nombre": "Chequeo rápido",
"parametros": ["tanque?"]
},
"chequeo_completo": {
"nombre": "Chequeo completo",
"parametros": ["tanque?", "con_retorta?"]
},
"correr_prueba": {
"nombre": "Correr una prueba",
"parametros": ["prueba", "tanque?"]
},
"diagnosticar": {
"nombre": "Formular diagnóstico",
"parametros": ["diagnostico"]
},
"esperar": {
"nombre": "Esperar",
"parametros": ["minutos"]
},
"tratar": {
"nombre": "Tratar con un producto",
"parametros": ["producto", "lb_bbl", "tanque"]
},
"ordenar_mezcla": {
"nombre": "Ordenar una mezcla",
"parametros": ["producto", "sacos", "tanque", "quien"]
},
"transferir": {
"nombre": "Transferir lodo",
"parametros": ["origen", "destino", "bbl"]
},
"avisar_driller": {
"nombre": "Avisar al driller",
"parametros": []
},
"entregar_reporte": {
"nombre": "Entregar el reporte",
"parametros": ["recomendaciones?"]
},
"inventario": {
"nombre": "Ver el inventario",
"parametros": []
},
"observar": {
"nombre": "Mirar la zona",
"parametros": []
},
"revisar_balance": {
"nombre": "Pedir el balance de volumen",
"parametros": []
},
"ver_resumen": {
"nombre": "Ver el objetivo y el avance",
"parametros": []
}
},
"estaciones": {
"caseta_lodos": {
"estacion": "caseta",
"acciones": ["chequeo_rapido", "chequeo_completo", "correr_prueba", "diagnosticar", "esperar"]
},
"embudo_abajo": {
"estacion": "embudo",
"acciones": ["tratar"]
},
"embudo_arriba": {
"estacion": "embudo",
"acciones": ["tratar"]
},
"tanque_succion": {
"estacion": "tanques",
"acciones": ["transferir", "ordenar_mezcla", "observar"]
},
"tanque_proceso": {
"estacion": "tanques",
"acciones": ["transferir", "ordenar_mezcla", "observar"]
},
"tanque_pildora": {
"estacion": "tanques",
"acciones": ["transferir", "ordenar_mezcla", "observar"]
},
"reserva_1": {
"estacion": "tanques",
"acciones": ["transferir", "ordenar_mezcla", "observar"]
},
"reserva_2": {
"estacion": "tanques",
"acciones": ["transferir", "ordenar_mezcla", "observar"]
},
"fractanque_1": {
"estacion": "tanques",
"acciones": ["transferir", "ordenar_mezcla", "observar"]
},
"fractanque_2": {
"estacion": "tanques",
"acciones": ["transferir", "ordenar_mezcla", "observar"]
},
"tanque_viaje": {
"estacion": "piso",
"acciones": []
},
"trampa_arena": {
"estacion": "zarandas",
"acciones": ["observar"]
},
"valvula_igualadora": {
"estacion": "tanques",
"acciones": []
},
"valvula_pildora": {
"estacion": "tanques",
"acciones": []
},
"valvula_reserva_1": {
"estacion": "tanques",
"acciones": []
},
"valvula_reserva_2": {
"estacion": "tanques",
"acciones": []
},
"valvula_fractanques": {
"estacion": "tanques",
"acciones": []
},
"bodega_quimicos": {
"estacion": "bodega",
"acciones": ["inventario"]
},
"zarandas": {
"estacion": "zarandas",
"acciones": ["observar"]
},
"caja_de_llegada": {
"estacion": "zarandas",
"acciones": ["observar"]
},
"piso_perforacion": {
"estacion": "piso",
"acciones": ["avisar_driller"]
},
"bombas_lodo": {
"estacion": "piso",
"acciones": []
},
"cabina_mud_logger": {
"estacion": "mud_logger",
"acciones": ["revisar_balance"]
},
"oficina_company_man": {
"estacion": "oficina",
"acciones": ["ver_resumen", "entregar_reporte"]
}
},
"parametros": {
"producto": "¿Qué producto?",
"lb_bbl": "¿Cuánto por barril?",
"tanque": "¿En qué tanque?",
"sacos": "¿Cuántos sacos?",
"quien": "¿Quién lo mezcla?",
"origen": "¿De dónde?",
"destino": "¿Hacia dónde?",
"bbl": "¿Cuántos barriles?",
"minutos": "¿Cuánto tiempo?",
"prueba": "¿Qué prueba?",
"diagnostico": "¿Cuál es la causa?"
},
"opciones_fijas": {
"lb_bbl": [[0.1, "0,1 lb/bbl"], [0.25, "0,25 lb/bbl"], [0.5, "0,5 lb/bbl"], [1.0, "1 lb/bbl"], [2.0, "2 lb/bbl"], [5.0, "5 lb/bbl"], [10.0, "10 lb/bbl"]],
"lb_bbl_agua": [[0.05, "5 % del tanque"], [0.1, "10 % del tanque"], [0.2, "20 % del tanque"]],
"sacos": [[5, "5 sacos"], [10, "10 sacos"], [20, "20 sacos"], [40, "40 sacos"], [80, "80 sacos"]],
"bbl": [[50, "50 bbl"], [100, "100 bbl"], [200, "200 bbl"], [400, "400 bbl"]],
"minutos": [[10, "10 min"], [30, "30 min"], [60, "1 hora"], [120, "2 horas"]],
"quien": [["encuellador", "Encuellador"], ["obrero_patio", "Obrero de patio"]]
}
}
